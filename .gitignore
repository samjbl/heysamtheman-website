.DS_Store
**/.DS_Store

# the ~60MB Instagram originals (renamed from "Top 5 reels" on 20 Sep 2026).
# video/ holds the web encodes, img/post-*.jpg the cropped stills.
Top Posts/

# Sam's photo library: full-resolution originals, HEIC included, filed by
# expedition. Add anything here — the site never loads from it. img/web/ holds
# the resized, web-safe copies the pages actually reference.
img/photos/

# contact sheets built to choose photos from
img/_sheets/

# files Claude staged for you to delete by hand
_to_delete/

# private dictation notes: names, health details, costs. Never publish.
Adventure Notes.md

# stray AVIFs from an early conversion run; the og/ cards ship as JPEG only
# because link scrapers do not read AVIF. Safe to delete in Finder.
img/og/*.avif
